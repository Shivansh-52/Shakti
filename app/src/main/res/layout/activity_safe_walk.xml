<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- FULLSCREEN GOOGLE MAP -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapView"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP HEADER APP BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:layout_gravity="top"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe Walk &amp; Live Tracking"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 GPS: High Accuracy • Real-Time"
                    android:textColor="#2E7D32"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnRecenterMap"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_location_pin"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/primary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- FLOATING SOS TRIGGER BUTTON -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabWalkSos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:text="🚨 SOS"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="#D32F2F"
        app:elevation="8dp"
        app:icon="@drawable/ic_sos"
        app:iconTint="@color/white" />

    <!-- STATE 1: SETUP JOURNEY CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNotStarted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_walk_nav"
                    app:tint="#F57C00" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Safe Walk Journey"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcasts live GPS movement to your trusted contacts"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DESTINATION INPUT -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint="Where are you walking to?"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:startIconDrawable="@drawable/ic_location_pin"
                app:startIconTint="#F57C00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDestAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Home (Rajpur Road, Dehradun)"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- QUICK CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/chipHome"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🏠 Home"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_primary"
                        app:strokeColor="#BDBDBD"
                        android:layout_marginEnd="6dp" />
                    <Button
                        android:id="@+id/chipWork"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🏢 Office / Work"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_primary"
                        app:strokeColor="#BDBDBD"
                        android:layout_marginEnd="6dp" />
                    <Button
                        android:id="@+id/chipCampus"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🎓 College / Campus"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_primary"
                        app:strokeColor="#BDBDBD"
                        android:layout_marginEnd="6dp" />
                    <Button
                        android:id="@+id/chipMarket"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🛒 Market"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_primary"
                        app:strokeColor="#BDBDBD" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- GUARDIAN NOTIFICATION NOTICE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8F5E9"
                android:padding="10dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#2E7D32" />
                <TextView
                    android:id="@+id/tvGuardianNotice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Emergency SMS with Live GPS Link will be dispatched automatically to your contacts."
                    android:textColor="#1B5E20"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <Button
                android:id="@+id/btnStartJourney"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="🚀 START SAFE WALK"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#F57C00"
                app:cornerRadius="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnFindBuddy"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="👥 Find Buddy"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#1976D2"
                    app:strokeColor="#1976D2"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnShareLiveTracking"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="🔗 Share Link"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#0D47A1"
                    app:strokeColor="#0D47A1"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- STATE 2: ACTIVE JOURNEY DASHBOARD CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardActiveJourney"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="26dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ACTIVE STATUS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/pulsingDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_indicator" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE SAFE WALK ACTIVE"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- STATS COUNTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:background="#F5F7FA"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTANCE"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvWalkDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 km"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvWalkSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km/h"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAFETY SCORE"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92/100"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>
            </LinearLayout>

            <!-- GUARDIAN NOTIFIED ROW -->
            <TextView
                android:id="@+id/tvLiveStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🛡️ Live tracking link sent to registered contacts via SMS."
                android:textColor="#0D47A1"
                android:textSize="11sp" />

            <!-- CHECK-IN PROMPT BANNER -->
            <LinearLayout
                android:id="@+id/layoutCheckInRequired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFEBEE"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ PERIODIC SAFETY CHECK-IN"
                    android:textColor="#C62828"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please confirm you are safe. SOS will trigger automatically if unattended."
                    android:textColor="#C62828"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>
                <Button
                    android:id="@+id/btnImSafe"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="I AM SAFE ✓"
                    android:textSize="12sp"
                    android:backgroundTint="#2E7D32"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- ACTIVE ACTION BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Button
                    android:id="@+id/btnActiveShare"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🔗 Share Link"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#1976D2"
                    app:strokeColor="#1976D2"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnActiveSos"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="🚨 TRIGGER SOS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="#D32F2F"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ARRIVED SAFELY -->
            <Button
                android:id="@+id/btnArrivedSafely"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="✓ I HAVE ARRIVED SAFELY"
                android:textSize="14sp"
                android:backgroundTint="#2E7D32"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnCancelJourney"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="Cancel Safe Walk"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
